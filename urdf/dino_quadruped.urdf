    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="foot_orange"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="rr_foot_joint" type="fixed">
    <parent link="rr_lower_leg"/>
    <child link="rr_foot"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
  </joint>

</robot>
